<h1><%= @merchant.name %></h1>
<h2>Links</h2>
<ul>
  <li><%= link_to "My Items", merchant_items_path(@merchant) %></li>
  <li><%= link_to "My Invoices", merchant_invoices_path(@merchant) %></li>
</ul>
<h2>Top 5 Customers</h2>
<ul>
  <% @merchant.top_5_customers_by_successful_transactions.each do | customer | %>
    <li>
        <%= "#{customer.first_name} #{customer.last_name}" %> -
        <%= customer.transaction_count %> successful transactions
    </li>
  <% end %>
</ul>
<h2>Items ready to ship</h2>
<ul>
    <% @merchant.items_ready_to_ship.each do | invoice_item | %>
        <li>
            <%= invoice_item.item.name %> -
            <%= link_to "Invoice ##{invoice_item.invoice.id}", merchant_invoice_path(@merchant, invoice_item.invoice) %>
            - <%= invoice_item.invoice.created_at.strftime("%A, %B, %d, %Y") %>
        </li>
    <% end %>
</ul>